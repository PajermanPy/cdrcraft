[Desktop Entry]
Type=Application
Name=CorelCraft
Comment=Editor vectorial compatible con CDR (basado en TraceDraw)
Exec=corelcraft %F
Icon=corelcraft
Terminal=false
Categories=Graphics;2DGraphics;VectorGraphics;
MimeType=application/x-tdraw;application/x-cdr;image/png;image/jpeg;image/bmp;image/gif;image/webp;image/tiff;
StartupWMClass=corelcraft
