[Desktop Entry]
Type=Application
Name=CDRCraft
Comment=Editor vectorial compatible con archivos de CorelDRAW (.cdr)
Exec=cdrcraft %F
Icon=cdrcraft
Terminal=false
Categories=Graphics;2DGraphics;VectorGraphics;
MimeType=application/x-tdraw;application/x-cdr;image/png;image/jpeg;image/bmp;image/gif;image/webp;image/tiff;
StartupWMClass=cdrcraft
